doctype html 
html
head
    title Final Project - Cameron Luong 
    link(rel="stylesheet", href="/stylesheet.css")
    script(src="/script.js")

body 
    header
        h1 Cam's Chat 




    if !user
        section#intro-creation 
            h2 To begin, let's create an account.

        #account-submission
            form#accountSubmissionForm
                .form-group 
                    label(for="username") Username: 
                    input#createUsername(type="text" name="username" placeholder="Enter Username" autocomplete = "off") 

                .form-group
                    label(for="password") Password:
                    input#createPassword(type="text" name="password" placeholder="Enter Password" autocomplete = "off")

                div 
                    button#submitAccount(type="submit") Submit

        #account-login
            h2 Already have an account? Let's login.
            form#accountLoginForm
                .form-group
                    label(for="user") Username: 
                    input#loginUsername(type="text" name="username" placeholder="Enter Username" autocomplete = "off")

                .form-group 
                    label(for="pass") Password:
                    input#loginPassword(type="text" name="password" placeholder="Enter Password" autocomplete = "off")

                div 
                    button#submitLogin(type="submit") Submit
    if user 
        div#user-info(style="position: fixed; top: 40px; right: 20px;")
        p Current User: #{user}
        form(action='/logout' method = 'POST')
            button(type='submit') Log Out

        section#friends 
            h2 Friends List
            select#friendsDropdown
                option(disable selected) -- Select a friend --
            button#refreshFriends Refresh Friends
        
        section#friend-requests 
            h2 Friend Requests 
            button#refreshRequests Refresh Requests
            ul#pendingRequests



        section#send-request 
            h2 Send a friend request 
            form#sendFriendForm
                input#friendUsername(type="text" placeholder="Enter username" autocomplete = "off")
                button#sendFriendRequest(type="submit") Send Request 


        section#chat
            h2 Chat 
            #chatWindow 

            form#sendMessageForm
                input#chatMessage(type="text" placeholder="Type a message" autocomplete = "off")
                button#sendChatMessage(type="submit") Send



    else 
        p(style="position: fixed; top: 40px; right: 20px;") Please Log In